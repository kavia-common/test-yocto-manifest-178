<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Remote definitions -->
  <remote name="github"
          fetch="https://github.com" />
  
  <!-- Default settings -->
  <default remote="github"
           revision="main"
           sync-j="2" />

  <!-- Meta layers for testing -->
  <project name="veera-ai/test-meta-core"
           path="sources/meta-test-core"
           remote="github" />
  
  <project name="veera-ai/test-meta-apps"
           path="sources/meta-test-apps"
           remote="github" />

</manifest>

